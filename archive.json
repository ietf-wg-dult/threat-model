  "issues": [
    {
      "number": 5,
      "id": "I_kwDOMB0Qas6QdqMg",
      "title": "Update levels of access to technological safeguards",
      "url": "https://github.com/ietf-wg-dult/threat-model/issues/5",
      "state": "CLOSED",
      "author": "maggiedelano",
      "authorAssociation": "COLLABORATOR",
      "assignees": [],
      "labels": [],
      "body": "- Instead of \u201cnormal\u201d \u2013 could this be \u201chigh\u201d? Normal implies a common baseline.\r\n- Instead of \u201cimpaired\u201d \u2013 could we use \u201climited\u201d? Not having a high-level of access could be due to lack of information/understanding or because of the type of control of the abuser and the inability to use tech safety.",
      "createdAt": "2024-07-22T20:15:11Z",
      "updatedAt": "2024-07-23T16:36:02Z",
      "closedAt": "2024-07-23T16:36:02Z",
      "comments": []
    },
    {
      "number": 15,
      "id": "I_kwDOMB0Qas6oCNB_",
      "title": "Update document to include discussion of specific attacks",
      "url": "https://github.com/ietf-wg-dult/threat-model/issues/15",
      "state": "OPEN",
      "author": "maggiedelano",
      "authorAssociation": "COLLABORATOR",
      "assignees": [],
      "labels": [],
      "body": "Update the threat model to discuss specific attacks on the DULT architecture. This could include:\n\n- Multiple tags following a single victim\n- Non-compliant tags (e.g. speaker disabled, altered firmware/firmware updates, spoofed, non-compliant tags)\n- Remote advertisement monitoring\n- Remote disablement\n\nEach of these attacks may be significant enough to warrant their own issues; this issue will link to those issues if/as they are created.\n\nThe document should also include discussion of attacks that are considered out of scope.",
      "createdAt": "2025-01-29T20:01:27Z",
      "updatedAt": "2025-01-29T20:02:47Z",
      "closedAt": null,
      "comments": []
    },
    {
      "number": 16,
      "id": "I_kwDOMB0Qas6oCOX4",
      "title": "Attack: multiple tags following single victim",
      "url": "https://github.com/ietf-wg-dult/threat-model/issues/16",
      "state": "OPEN",
      "author": "maggiedelano",
      "authorAssociation": "COLLABORATOR",
      "assignees": [
        "maggiedelano"
      ],
      "labels": [],
      "body": "Discuss the attack by which multiple tags are tracking a single victim, which could impact the efficiency of protocols such as [Multi-Dealer Secret Sharing](https://eprint.iacr.org/2023/1332.pdf) (MDSS).",
      "createdAt": "2025-01-29T20:04:29Z",
      "updatedAt": "2025-01-29T20:10:50Z",
      "closedAt": null,
      "comments": []
    },
    {
      "number": 17,
      "id": "I_kwDOMB0Qas6oCPTI",
      "title": "Attack: remote advertisement monitoring",
      "url": "https://github.com/ietf-wg-dult/threat-model/issues/17",
      "state": "OPEN",
      "author": "maggiedelano",
      "authorAssociation": "COLLABORATOR",
      "assignees": [
        "maggiedelano"
      ],
      "labels": [],
      "body": "Discuss an attack by which bluetooth advertisement packets are monitored in order to track an individual using these packets rather than by the tracking network (see discussion [here](https://eprint.iacr.org/2023/1332.pdf))",
      "createdAt": "2025-01-29T20:06:09Z",
      "updatedAt": "2025-01-29T20:10:50Z",
      "closedAt": null,
      "comments": []
    },
